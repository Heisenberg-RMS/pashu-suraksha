<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Primary Fullscreen PWA WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fullscreen Native Splash & Loading Screen Overlay -->
    <RelativeLayout
        android:id="@+id/splashContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0f766e"
        android:clickable="true"
        android:focusable="true">

        <!-- Splash Poster Artwork -->
        <ImageView
            android:id="@+id/splashImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/splash_screen"
            android:contentDescription="@string/app_name" />

        <!-- Lower Section: Sleek Loading Line & Progress -->
        <LinearLayout
            android:id="@+id/splashLoaderSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Horizontal Progress / Loading Line -->
            <ProgressBar
                android:id="@+id/splashProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="10"
                android:progressDrawable="@drawable/splash_progress_bar" />

            <!-- Subtitle Status -->
            <TextView
                android:id="@+id/splashStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="पशु सुरक्षा प्रणाली प्रारंभ हो रही है..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#D0000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
